      "notes": [
        "恢复文章链接：https://tech.chuangzhidou.com/2019/04/02/django-deploy/ → /p/django-deploy/"
      ],
      "code_blocks": [
        "class Solution(object):\n    def linklistToNum(self, l):\n        times = 1\n        result = 0\n\n        while l:\n            result += int(l.val) * times\n            times *= 10\n            l = l.next\n        return result\n\n    def NumTolinklist(self, num):\n        target = []\n\n        for c in str(num):\n            target.append(c)\n\n        head = ListNode(None)\n        point = head\n        while target != []:\n            tmp = target.pop()\n            point.next = ListNode(tmp)\n            point = point.next\n\n        return head.next\n\n    def addTwoNumbers(self, l1, l2):\n        \"\"\"\n        :type l1: ListNode\n        :type l2: ListNode\n        :rtype: ListNode\n        \"\"\"\n        num1 = self.linklistToNum(l1)\n        num2 = self.linklistToNum(l2)\n        answer = num1 + num2\n\n        return self.NumTolinklist(answer)"
      ],
      "review": {
