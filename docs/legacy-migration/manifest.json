      "code_blocks": [
        "def reverse(self, x):\n    \"\"\"\n    :type x: int\n    :rtype: int\n    \"\"\"        \n    notNegative = True\n    target = []\n\n    for c in str(x):\n        if c == '-':\n            notNegative = False\n            continue\n        target.append(c)\n    target.reverse()\n    answer = ''.join(target)\n    if notNegative:\n        answer = int(answer)\n    else:\n        answer = int(answer) * -1\n    \n    limitation = [-1 * pow(2,31), pow(2,31)-1]\n    if answer <= limitation[0] or answer >= limitation[1]:\n        return 0\n    else:\n        return answer"
      ],
